# version 2--------------------------------------------------------------------------------        

        inner_1_stk <- function(x, x_dilute) (1-x) * x_dilute * (1-x)
        inner_1_dil <- function(x, x_dilute) (1-x) * (1 - x_dilute * (1-x))
        inner_2_stk <- function(x, x_dilute) x     * x_dilute * (1-x)       
        inner_2_dil <- function(x, x_dilute) x     * (1 - x_dilute * (1-x))
        outer_1_stk <- function(x, x_dilute) (1-x) * x_dilute * x          
        outer_1_dil <- function(x, x_dilute) (1-x) * (1 - x_dilute * x)    
        outer_2_stk <- function(x, x_dilute) x     * x_dilute * x          
        outer_2_dil <- function(x, x_dilute) x     * (1 - x_dilute * x)    
        inner_stk   <- function(x, x_dilute) inner_1_stk(x, x_dilute) + inner_2_stk(x, x_dilute)
        inner_dil   <- function(x, x_dilute) inner_1_dil(x, x_dilute) + inner_2_dil(x, x_dilute)
        outer_stk   <- function(x, x_dilute) outer_1_stk(x, x_dilute) + outer_2_stk(x, x_dilute)
        outer_dil   <- function(x, x_dilute) outer_1_dil(x, x_dilute) + outer_2_dil(x, x_dilute)
        
        x <- seq(0,1,by=0.05)
        
        gen_stuff <- function(x, x_dilute) {
            make_df <- function(fn, lbl, x_dilute_val) {
                df <- data.frame(x = x) 
                print(df)
                df %>%
                    mutate(
                        y = map_dbl(x, .f = ~ fn(.x, x_dilute_val)),
                        lbl = lbl,
                        x_dilute = x_dilute_val,
                        )
            }
            make_bunch <- function(x_dilute_val) {
                list(
                    make_df(inner_1_stk, "inner stock 1",         x_dilute_val),
                    make_df(inner_2_stk, "inner stock 2",         x_dilute_val),
                    make_df(inner_1_dil, "inner diluter 1",       x_dilute_val),
                    make_df(inner_2_dil, "inner diluter 2",       x_dilute_val),
                    make_df(outer_1_stk, "outer stock 1",         x_dilute_val),
                    make_df(outer_2_stk, "outer stock 2",         x_dilute_val),
                    make_df(outer_1_dil, "outer diluter 1",       x_dilute_val),
                    make_df(outer_2_dil, "outer diluter 2",       x_dilute_val),
                    make_df(inner_stk,   "inner stock (1 + 2)",   x_dilute_val),
                    make_df(inner_dil,   "inner diluter (1 + 2)", x_dilute_val),
                    make_df(outer_stk,   "outer stock (1 + 2)",   x_dilute_val),
                    make_df(outer_dil,   "outer diluter (1 + 2)", x_dilute_val)
                    ) %>%
                reduce(rbind)
            }
            x_dilute %>%
                map(.f = make_bunch) %>%
                reduce(.f = rbind)
        }

     tr <- list(`TRUE` = "outer", `FALSE` = "inner")

