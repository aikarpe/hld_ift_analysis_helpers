# version 1--------------------------------------------------------------------------------        
        gen_bit <- function(x_dilute) {
        data.frame(x = seq(0,1,by = 0.05)) %>% 
            mutate(
                x_dilute = x_dilute,
                inner_1_stk =  (1-x) * x_dilute * (1-x), 
                inner_1_dil =  (1-x) * (1 - x_dilute * (1-x)),
                inner_2_stk =  x     * x_dilute * (1-x), 
                inner_2_dil =  x     * (1 - x_dilute * (1-x)),
                outer_1_stk =  (1-x) * x_dilute * x    ,
                outer_1_dil =  (1-x) * (1 - x_dilute * x)    ,
                outer_2_stk =  x     * x_dilute * x    ,
                outer_2_dil =  x     * (1 - x_dilute * x)    ,
            )
        }

        plot_it <- function(df) {
            params <- list(
                list(lt = 1, cl = "steelblue3"),
                list(lt = 2, cl = "steelblue3"),
                list(lt = 1, cl = "royalblue2"),
                list(lt = 2, cl = "royalblue2"),
                list(lt = 1, cl = "gold1"),
                list(lt = 2, cl = "gold1"),
                list(lt = 1, cl = "goldenrod1"),
                list(lt = 2, cl = "goldenrod1")
                )
            df %>%
                mutate(
                    inner_stk = inner_1_stk + inner_2_stk,
                    inner_dil = inner_1_dil + inner_2_dil,
                    outer_stk = outer_1_stk + outer_2_stk,
                    outer_dil = outer_1_dil + outer_2_dil,
                    ) %>%
                ggplot(aes(x = x)) + 
                    geom_line(aes(y = inner_1_stk), linetype = params[[1]][["lt"]], color = params[[1]][["cl"]])  +
                    geom_line(aes(y = inner_1_dil), linetype = params[[2]][["lt"]], color = params[[2]][["cl"]])  +
                    geom_line(aes(y = inner_2_stk), linetype = params[[3]][["lt"]], color = params[[3]][["cl"]])  +
                    geom_line(aes(y = inner_2_dil), linetype = params[[4]][["lt"]], color = params[[4]][["cl"]])  +
                    #geom_line(aes(y = outer_1_stk), linetype = params[[5]][["lt"]], color = params[[5]][["cl"]])  +
                    #geom_line(aes(y = outer_1_dil), linetype = params[[6]][["lt"]], color = params[[6]][["cl"]])  +
                    #geom_line(aes(y = outer_2_stk), linetype = params[[7]][["lt"]], color = params[[7]][["cl"]])  +
                    #geom_line(aes(y = outer_2_dil), linetype = params[[8]][["lt"]], color = params[[8]][["cl"]])  +
                    geom_line(aes(y = inner_stk), linetype =                  1                              )  +
                    geom_line(aes(y = inner_dil), linetype =                  2                              )  +
                    facet_wrap(~ x_dilute, ncol = 1)
        }

